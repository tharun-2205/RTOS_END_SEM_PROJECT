import streamlit as st
import serial
import plotly.graph_objects as go
from collections import deque
import time

st.set_page_config(
    page_title="Nuclear RTOS Dashboard",
    layout="wide"
)

st.title("RTOS Based Auxiliary Safety Monitoring System")

st.write(
"Priority: Radiation > MQ2 Hazard > Temperature"
)

try:
    ser=serial.Serial(
        'COM7',   # Change COM port
        115200,
        timeout=1)

except:
    st.error("Check COM port")
    st.stop()

rad=deque(maxlen=20)
gas=deque(maxlen=20)
temp=deque(maxlen=20)
tick=deque(maxlen=20)

placeholder=st.empty()

blink=False

while True:

    try:

        line=ser.readline().decode().strip()

        data=line.split(",")

        if len(data)==4:

            radiation=int(data[0])
            mq2=int(data[1])
            temperature=float(data[2])
            ticks=int(data[3])

            rad.append(radiation)
            gas.append(mq2)
            temp.append(temperature)
            tick.append(ticks)

            status="NORMAL"

            alert=False

            if radiation>70:
                status="RADIATION ALERT"
                alert=True

            elif mq2>1500:
                status="MQ2 ALERT"
                alert=True

            elif temperature>35:
                status="TEMP ALERT"
                alert=True


            with placeholder.container():

                c1,c2,c3,c4,c5=st.columns(5)

                c1.metric(
                    "Radiation",
                    radiation)

                c2.metric(
                    "MQ2",
                    mq2)

                c3.metric(
                    "Temperature",
                    temperature)

                c4.metric(
                    "Status",
                    status)


                # BLINKING ALERT LED
                if alert:

                    blink=not blink

                    if blink:

                        c5.markdown(
                        """
                        <div style="
                        width:60px;
                        height:60px;
                        border-radius:50%;
                        background:red;
                        margin:auto;
                        box-shadow:
                        0px 0px 30px red;">
                        </div>

                        <center>
                        ALERT
                        </center>
                        """,
                        unsafe_allow_html=True)

                    else:

                        c5.markdown(
                        """
                        <div style="
                        width:60px;
                        height:60px;
                        border-radius:50%;
                        background:#330000;
                        margin:auto;">
                        </div>

                        <center>
                        ALERT
                        </center>
                        """,
                        unsafe_allow_html=True)

                else:

                    c5.markdown(
                    """
                    <div style="
                    width:60px;
                    height:60px;
                    border-radius:50%;
                    background:green;
                    margin:auto;
                    box-shadow:
                    0px 0px 20px green;">
                    </div>

                    <center>
                    SAFE
                    </center>
                    """,
                    unsafe_allow_html=True)


                fig=go.Figure()

                fig.add_scatter(
                    y=rad,
                    name="Radiation")

                fig.add_scatter(
                    y=gas,
                    name="MQ2")

                fig.add_scatter(
                    y=temp,
                    name="Temperature")

                st.plotly_chart(
                    fig,
                    use_container_width=True)

                fig2=go.Figure()

                fig2.add_scatter(
                    y=tick,
                    name="RTOS Tick")

                st.plotly_chart(
                    fig2,
                    use_container_width=True)

        time.sleep(.5)

    except:
        pass
